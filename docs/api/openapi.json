  "components": {
    "schemas": {
      "DepartmentRequestDTO": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "description": "Nombre no vacio",
            "example": "Antioquia"
          }
        },
        "description": "Datos para crear o actualizar Department."
      },
      "ApiProblem": {
        "required": [
          "detail",
          "instance",
          "status",
          "title",
          "type"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "example": "urn:problem:http:400"
          },
          "title": {
            "type": "string",
            "example": "Bad Request"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "example": 400
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri",
            "example": "/api/v1/cities"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "description": "Mapa campo -> mensaje; presente solo para errores de validacion."
            },
            "description": "Mapa campo -> mensaje; presente solo para errores de validacion."
          }
        },
        "description": "Error ProblemDetail. errors contiene mensajes por campo en errores de validacion."
      },
      "DepartmentResponseDTO": {
        "required": [
          "createdAt",
          "createdBy",
          "id",
          "name",
          "updatedAt",
          "updatedBy"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "maxLength": 100,
            "type": "string",
            "example": "Antioquia"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedBy": {
            "type": "string"
          }
        },
        "description": "Department persistido, con identificador y auditoria."
      },
      "CityRequestDTO": {
        "required": [
          "departmentId",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "description": "Nombre no vacio",
            "example": "Medellin"
          },
          "departmentId": {
            "type": "string",
            "description": "UUID de un departamento existente",
            "format": "uuid"
          }
        },
        "description": "Datos para crear o actualizar City."
      },
      "CityResponseDTO": {
        "required": [
          "createdAt",
          "createdBy",
          "departmentId",
          "id",
          "name",
          "updatedAt",
          "updatedBy"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "maxLength": 100,
            "type": "string",
            "example": "Medellin"
          },
          "departmentId": {
            "type": "string",
            "format": "uuid"
          },
